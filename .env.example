# Copier en .env.local (dev) ou .env (docker compose) puis renseigner les valeurs.
# Ce fichier est versionné : il ne doit JAMAIS contenir de valeur réelle.

# --- Base de données (PostgreSQL + pgvector) ---------------------------------
# En docker compose, viser le container par son nom (le réseau app-staging est
# partagé : un alias générique comme "db" collisionnerait avec une autre stack).
#   postgres://trainarr:<mot-de-passe>@trainarr-db:5432/trainarr
# En dev hors Docker : postgres://trainarr:<mot-de-passe>@localhost:5432/trainarr
DATABASE_URL=
POSTGRES_USER=trainarr
POSTGRES_PASSWORD=
POSTGRES_DB=trainarr

# --- Coach IA (abstraction compatible OpenAI) --------------------------------
# AI_PROVIDER : llamacpp | anthropic | openai
AI_PROVIDER=llamacpp
# URL de l'API compatible OpenAI (llama-server local : http://localhost:8080/v1)
AI_BASE_URL=http://localhost:8080/v1
AI_MODEL=
# Laisser vide pour llama.cpp local ; requis pour anthropic/openai
AI_API_KEY=

# --- URL publique de l'application -------------------------------------------
# C'est par cette URL que la montre atteint le dépôt WebDAV (/dav).
APP_BASE_URL=https://watchenv.gwenzr.dev

# --- Import FIT : dossier surveillé ------------------------------------------
# Le service `fit-watcher` scanne ce répertoire, importe les *.fit dont l'upload
# est terminé, puis les range dans processed/ ou failed/ (avec un .err.txt).
# En docker compose la valeur est imposée par le point de montage du volume
# trainarr-fit-inbox : ne la surcharger ici que pour un test hors Docker.
FIT_INBOX_DIR=/data/fit-inbox
# Intervalle entre deux scans, en secondes. C'est aussi le délai minimal avant
# qu'un fichier soit jugé complet : sa taille doit être stable sur deux scans.
FIT_WATCH_INTERVAL_S=30

# --- intervals.icu (rapatriement automatique des FIT) ------------------------
# HealthFit synchronise les séances vers intervals.icu ; le service `fit-watcher`
# y récupère les fichiers d'activité originaux et les dépose dans FIT_INBOX_DIR,
# où il les ingère comme n'importe quel dépôt WebDAV.
# Le poller ne démarre que si les DEUX variables ci-dessous sont renseignées ;
# sinon il le signale au démarrage et le watcher fonctionne comme avant.
#
# Identifiant d'athlète, préfixe « i » compris — il est dans l'URL intervals.icu
# (https://intervals.icu/athlete/i123456/...). Format attendu : i + chiffres.
INTERVALS_ATHLETE_ID=
# Clé API personnelle : intervals.icu → Settings → Developer Settings.
# Secret : jamais dans le repo, jamais dans un log.
INTERVALS_API_KEY=
# Intervalle entre deux cycles de rapatriement, en secondes (défaut 300).
INTERVALS_POLL_INTERVAL_S=300
# Profondeur de la fenêtre interrogée à chaque cycle, en jours (défaut 30).
INTERVALS_LOOKBACK_DAYS=30

# --- WebDAV (dépôt des fichiers FIT depuis la montre) ------------------------
# Identifiants du point de dépôt WebDAV servi par l'appli elle-même sur
# https://<domaine>/dav (cf. src/lib/fit/dav.ts) : c'est là que la montre envoie
# ses fichiers. Choisir un mot de passe long — le reverse proxy expose ce chemin
# sur Internet, en écriture, et l'authentification Basic ne vaut que par TLS.
# Tant que les deux ne sont pas renseignés, /dav répond 503 (jamais ouvert).
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
