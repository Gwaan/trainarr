# Copier en .env.local (dev) ou .env (docker compose) puis renseigner les valeurs.
# Ce fichier est versionné : il ne doit JAMAIS contenir de valeur réelle.

# --- Base de données (PostgreSQL + pgvector) ---------------------------------
# En docker compose, viser le container par son nom (le réseau app-staging est
# partagé : un alias générique comme "db" collisionnerait avec une autre stack).
#   postgres://trainarr:<mot-de-passe>@trainarr-db:5432/trainarr
# En dev hors Docker : postgres://trainarr:<mot-de-passe>@localhost:5432/trainarr
DATABASE_URL=
POSTGRES_USER=trainarr
POSTGRES_PASSWORD=
POSTGRES_DB=trainarr

# --- Coach IA (abstraction compatible OpenAI) --------------------------------
# Provider : llamacpp | anthropic | openai. Tous parlent le format « chat
# completions » d'OpenAI ; seul le point de contrôle de disponibilité diffère
# (llama-server expose /health, les autres /v1/models).
AI_PROVIDER=llamacpp
# URL de l'API llama.cpp, ex: http://192.168.1.x:8080 — ABSENTE = fonctions IA
# suspendues (l'appli le dit et ne tente aucun appel ; tout le reste fonctionne).
# C'est la RACINE du serveur, sans /v1 : les endpoints natifs de llama-server
# vivent en dehors (/health). Un /v1 final serait de toute façon ignoré.
AI_BASE_URL=
# Nom du modèle transmis à l'API. Vide, c'est « default » qui est envoyé —
# llama-server ne sert que le modèle qu'il a chargé, le nom lui est indifférent.
AI_MODEL=
# Laisser vide pour llama.cpp local ; requis pour anthropic/openai.
# Secret : jamais dans le repo, jamais dans un log.
AI_API_KEY=

# --- URL publique de l'application -------------------------------------------
# C'est par cette URL que la montre atteint le dépôt WebDAV (/dav).
APP_BASE_URL=https://watchenv.gwenzr.dev

# --- Import FIT : dossier surveillé ------------------------------------------
# L'application scanne elle-même ce répertoire (un seul container : les boucles
# d'import tournent dans le process du serveur), importe les *.fit dont l'upload
# est terminé, puis les range dans processed/ ou failed/ (avec un .err.txt).
# En docker compose la valeur est imposée par le point de montage du volume
# trainarr-fit-inbox : ne la surcharger ici que pour un test hors Docker.
FIT_INBOX_DIR=/data/fit-inbox
# Intervalle entre deux scans, en secondes. C'est aussi le délai minimal avant
# qu'un fichier soit jugé complet : sa taille doit être stable sur deux scans.
FIT_WATCH_INTERVAL_S=30

# --- intervals.icu (rapatriement automatique des FIT) ------------------------
# HealthFit synchronise les séances vers intervals.icu ; l'application y récupère
# les fichiers d'activité originaux et les dépose dans FIT_INBOX_DIR, où elle les
# ingère comme n'importe quel dépôt WebDAV.
#
# La même clé sert dans l'autre sens : les séances planifiées par le coach sont
# poussées au calendrier intervals.icu (créées, mises à jour, supprimées à
# l'archivage du plan). Sans clé, le plan reste dans Trainarr, rien d'autre.
#
# Clé API personnelle : intervals.icu → Settings → Developer Settings.
# SEULE variable requise pour activer le rapatriement. Sans elle, le poller reste
# inactif, le signale au démarrage, et le reste de l'import fonctionne.
# Secret : jamais dans le repo, jamais dans un log.
INTERVALS_API_KEY=
# Identifiant d'athlète — FACULTATIF. Laissé vide, l'API est interrogée sur
# l'athlète « 0 », que intervals.icu résout en « le propriétaire de la clé ».
# À ne renseigner que pour viser un autre athlète (compte de coach). Il est dans
# l'URL intervals.icu (https://intervals.icu/athlete/i123456/...) ; « i123456 »
# comme « 123456 » sont acceptés. Une valeur illisible n'empêche pas
# l'application de démarrer : elle désactive le poller seul, en disant pourquoi.
INTERVALS_ATHLETE_ID=
# Intervalle entre deux cycles de rapatriement, en secondes (défaut 60) : c'est
# la latence typique entre une séance arrivée sur intervals.icu et son import.
INTERVALS_POLL_INTERVAL_S=60
# Profondeur de la fenêtre interrogée à chaque cycle, en jours (défaut 30).
# Elle ne s'applique qu'une fois l'historique rapatrié : au premier démarrage,
# tant qu'aucune séance n'a été récupérée, c'est TOUT l'historique qui est
# demandé, par tranches de 50 fichiers par cycle.
INTERVALS_LOOKBACK_DAYS=30

# --- Authentification (better-auth) ------------------------------------------
# Secret de signature des sessions et des jetons. Le générer une fois, puis ne
# plus en changer : le modifier invalide toutes les sessions ouvertes.
#   openssl rand -base64 32
# 32 caractères au minimum. FACULTATIF : sans lui, l'authentification est
# inopérante (l'écran de connexion l'explique, /api/auth répond 503) mais
# l'application démarre et sert ses pages normalement.
# Secret : jamais dans le repo, jamais dans un log.
BETTER_AUTH_SECRET=

# --- WebDAV (dépôt des fichiers FIT depuis la montre) ------------------------
# Identifiants du point de dépôt WebDAV servi par l'appli elle-même sur
# https://<domaine>/dav (cf. src/lib/fit/dav.ts) : c'est là que la montre envoie
# ses fichiers. Choisir un mot de passe long — le reverse proxy expose ce chemin
# sur Internet, en écriture, et l'authentification Basic ne vaut que par TLS.
# Tant que les deux ne sont pas renseignés, /dav répond 503 (jamais ouvert).
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
