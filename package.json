{
  "name": "trainarr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
